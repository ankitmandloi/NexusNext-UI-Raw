{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2017"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/app/(app)/basic-master/address-master/pin-code/page.jsx", "src/app/(app)/basic-master/address-master/district/page.jsx", "src/app/(app)/basic-master/address-master/region-assignment/page.jsx", "src/app/(app)/basic-master/address-master/city/page.jsx", "src/app/(app)/basic-master/address-master/state/page.jsx", "src/app/(app)/basic-master/group/page.jsx", "src/app/(app)/basic-master/group-tag/page.jsx", "src/app/(app)/customer-master/customer/page.jsx", "src/app/(app)/employee-manager/area-master/page.jsx", "src/app/(app)/employee-manager/employees/employee-designation/page.jsx", "src/app/(app)/schema/coupon-schema/generate-coupon/page.tsx", "src/app/(app)/schema/coupon-schema/page.tsx"],
  "exclude": ["node_modules"]
}
